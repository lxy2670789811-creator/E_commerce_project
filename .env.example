# ===== 环境变量示例 =====
# 用法：
#   1. 复制本文件为 .env 或直接在你的 shell / IDE Run Configuration 中设置同名环境变量；
#   2. Spring 通过 ${VAR:default} 读取，未设置时使用冒号后的默认值。

# DeepSeek 大模型 API Key（必填，否则 AI 售后分析会走"待人工审核"降级）
# 获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# MySQL
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# Nacos 账号（默认 nacos/nacos，仅本地开发）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# 中间件地址（docker-compose 或本机部署时按需调整）
REDIS_HOST=localhost
REDIS_PORT=6379
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
SENTINEL_DASHBOARD=127.0.0.1:8858